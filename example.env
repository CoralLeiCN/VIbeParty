# VibeParty local Word by Word demo
# Copy this file to .env in the repository root and edit that private copy.
# These are planned backend settings; the app and .env loading are not built yet.
# Keep Reactor keys out of this template and frontend/VITE_ variables.

# Create a key at https://reactor.inc/account/api-keys (keys start with rk_).
# Required for live generation; leave empty for fixture mode.
REACTOR_API_KEY=

# Fixed host passcode for the local hackathon demo.
HOST_PASSCODE=WMHACK

# fixture = labelled prerecorded example; live = paid Reactor generation.
# Change to live when the key, credits, and video integration are ready.
GENERATION_MODE=fixture

# Laptop-only development. For phones, replace localhost with the laptop's
# LAN IP, e.g. http://192.168.1.42:8000, and use that URL on every device.
# The backend will use this exact origin for join links and Origin checks.
PUBLIC_ORIGIN=http://localhost:8000

# Fixed video model and target duration per segment.
REACTOR_MODEL=reactor/fast-h3
CLIP_DURATION_SECONDS=6

# Planned per-process limits. Restarting the server resets the attempt count.
MAX_LIVE_SESSION_ATTEMPTS=3
GENERATION_TIMEOUT_SECONDS=120
STEP_TIMEOUT_SECONDS=30
# The backend must pass this cap to Reactor when authorizing a session.
REACTOR_MAX_SESSION_DURATION_SECONDS=180

# App-owned temporary clips, relative to the repository root; ignored by Git.
# The backend may clear this directory on startup, reset, or round cleanup.
MEDIA_DIR=.local/vibeparty/clips
