# VibeParty local application
# Copy this file to .env in the repository root and edit that private copy.
# Root .env is loaded by the backend; process environment takes precedence.
# Keep Reactor keys out of this template and frontend/VITE_ variables.

# Create a key at https://reactor.inc/account/api-keys (keys start with rk_).
# Required for live generation; leave empty for fixture mode.
REACTOR_API_KEY=

# Local mode lets anyone on the configured laptop address create a room and
# share its join link. Set false to require host/organizer codes, then restart.
LOCAL_MODE=true
# Used only when LOCAL_MODE=false.
HOST_PASSCODE=WMHACK

# fixture = labelled prerecorded example; live = paid Reactor generation.
# Change to live when the key, credits, and video integration are ready.
GENERATION_MODE=fixture

# Laptop-only development. For phones, replace localhost with the laptop's
# LAN IP, e.g. http://192.168.1.42:8000, and use that URL on every device.
# The backend will use this exact origin for join links and Origin checks.
PUBLIC_ORIGIN=http://localhost:8000

# Fixed video model and target duration per segment.
REACTOR_MODEL=reactor/fast-h3
CLIP_DURATION_SECONDS=6

# Planned per-process limits. Restarting the server resets the attempt count.
MAX_LIVE_SESSION_ATTEMPTS=3
GENERATION_TIMEOUT_SECONDS=120
STEP_TIMEOUT_SECONDS=30
# The backend must pass this cap to Reactor when authorizing a session.
REACTOR_MAX_SESSION_DURATION_SECONDS=180

# App-owned temporary clips, relative to the repository root; ignored by Git.
# The backend may clear this directory on startup, reset, or round cleanup.
MEDIA_DIR=.local/vibeparty/clips

# Shared worktree configuration. scripts/dev.sh uses FRONTEND_PORT as browser
# origin unless BROWSER_ORIGIN is explicitly exported; demo uses these values.
BACKEND_PORT=8000
FRONTEND_PORT=5173
BROWSER_ORIGIN=http://localhost:8000
# Optional explicit Vite API proxy override (otherwise uses BACKEND_PORT).
API_PROXY_TARGET=
# Private clips: <MEDIA_ROOT>/<game-id>/clips. Never serve this as static files.
MEDIA_ROOT=.local/vibeparty
# Persistent campaign data/model cache; never delete during party cleanup.
REVERSE_PROMPT_QUOTA_FILE=.local/vibeparty-persistent/reverse-prompt/quota.json
EMBEDDING_MODEL_PATH=.local/vibeparty-persistent/models/all-MiniLM-L6-v2
# Game-specific live settings are validated by each game before paid work.
# Fixture is the default; GENERATION_MODE alone never grants a live allowance.

# Optional explicit trusted aliases for independent local browser sessions.
# JSON array; leave empty for the normal combined LAN demo. No wildcards.
ADDITIONAL_BROWSER_ORIGINS=[]

# Enable the host's Live LingBot World 2 round option using REACTOR_API_KEY.
# Generation starts after all four contributions; three attempts per server run.
WORD_BY_WORD_LIVE_ENABLED=false
# Choose the image source in the host lobby for each round: Codex, upload, API,
# or the configured server image. Generation uses only the accepted Place answer.
# Codex uses the host's existing `codex login` (ChatGPT); no OpenAI API key needed.
WORD_BY_WORD_CODEX_COMMAND=codex
WORD_BY_WORD_CODEX_TIMEOUT=150
# OPENAI_API_KEY is needed only for the explicit API image source.
WORD_BY_WORD_IMAGE_MODEL=gpt-image-2.5-flare
WORD_BY_WORD_CATEGORY_SECONDS=6
# Optional source, selected explicitly in the lobby: a local image matching Place.
# WORD_BY_WORD_SEED_IMAGE=.local/enchanted-forest.png

# Prompt Royale: hosts can switch video mode in the lobby once live setup is ready.
# GENERATION_MODE only sets the initial room mode. Topic mode is configured separately.
PROMPT_ROYALE_LIVE_ENABLED=false
PROMPT_ROYALE_REHEARSED_CAPACITY=0
PROMPT_ROYALE_LIVE_SLOT=
PROMPT_ROYALE_TOPIC_MODE=fixture
OPENAI_API_KEY=

# Reverse Prompt's selected replacement uses fixed reactor/fast-h3 (no model selector).
# Enable only for allocated live acceptance; use the coordinator's single
# persistent quota file and exclusive live trial slot.
REVERSE_PROMPT_LIVE_ENABLED=false
# Optional ORGANIZER_CODE override when LOCAL_MODE=false; omit to use HOST_PASSCODE.
# An empty override blocks hosting only when LOCAL_MODE=false.
